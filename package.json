{
  "name": "campus-sensor-alerts",
  "version": "0.1.0",
  "private": true,
  "description": "Campus sensor monitoring and alerts backend (GDG Backend Task 1)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:create": "tsx --env-file-if-exists=.env scripts/db-create.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:test:reset": "tsx --env-file-if-exists=.env scripts/db-create.ts --test --reset && tsx --env-file-if-exists=.env src/db/migrate.ts --test",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "sim": "tsx --env-file-if-exists=.env simulator/index.ts",
    "loadtest": "tsx --env-file-if-exists=.env loadtest/run.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "typebox": "^1.3.37",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pidusage": "^2.0.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.12.0",
    "pidusage": "^4.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
