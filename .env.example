# Copy to .env and fill in. URL-encode special characters in the password (e.g. @ -> %40).
PORT=3000
DATABASE_URL=postgres://postgres:<password>@localhost:5432/campus_sensors
TEST_DATABASE_URL=postgres://postgres:<password>@localhost:5432/campus_sensors_test
PG_POOL_MAX=10
BUFFER_CAPACITY=100000
FLUSH_INTERVAL_MS=10
FLUSH_MAX_ROWS=2000
FLUSH_CONCURRENCY=3
COMMIT_RETRY_BUDGET_MS=5000
BATCH_MAX_ITEMS=1000
BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
REQUEST_LOGGING=true
